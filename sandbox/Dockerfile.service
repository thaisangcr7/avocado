# The sandbox runner. Small on purpose: it holds the Docker socket, so the less
# it contains, the less a compromise is worth.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# The docker CLI is the one privileged tool here; it is what starts the
# per-analysis containers.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg \
      | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
 && chmod a+r /etc/apt/keyrings/docker.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
      https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
      > /etc/apt/sources.list.d/docker.list \
 && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        "fastapi==0.115.6" \
        "uvicorn[standard]==0.34.0" \
        "pydantic==2.10.4" \
        "pydantic-settings==2.7.1" \
        "structlog==24.4.0"

WORKDIR /srv
# Only the sandbox client code is copied, not the whole application: this
# service has no business being able to reach the database or the models.
COPY backend/app/clients/sandbox/base.py       backend/app/clients/sandbox/base.py
COPY backend/app/clients/sandbox/docker_sandbox.py backend/app/clients/sandbox/docker_sandbox.py
COPY backend/app/core/logging.py               backend/app/core/logging.py
COPY backend/app/core/errors.py                backend/app/core/errors.py
COPY sandbox/service.py                        sandbox/service.py
RUN touch backend/app/__init__.py backend/app/clients/__init__.py \
          backend/app/clients/sandbox/__init__.py backend/app/core/__init__.py

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8080/health || exit 1

CMD ["uvicorn", "sandbox.service:app", "--host", "0.0.0.0", "--port", "8080"]
