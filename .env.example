# ---------------------------------------------------------------------------
# Avocado — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The app refuses to start if a CHANGE_ME placeholder survives into a
# non-development environment (see backend/app/core/config.py).
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# --- Security ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- Database ---------------------------------------------------------------
# Local docker-compose default. In cloud, point at Neon/Supabase.
DATABASE_URL=postgresql+asyncpg://avocado:avocado@localhost:5434/avocado

# --- Redis (cache, rate limit, job queue) -----------------------------------
REDIS_URL=redis://localhost:6380/0

# --- Object storage ---------------------------------------------------------
# STORAGE_BACKEND: "local" (dev only) or "s3" (S3 / Cloudflare R2)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./.localstorage
S3_BUCKET=avocado-documents
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- LLM providers ----------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings -------------------------------------------------------------
# EMBEDDING_PROVIDER: "voyage" | "openai" | "hash" (hash = offline dev/test only)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Speech to text (voice) -------------------------------------------------
# STT_PROVIDER: "deepgram" | "disabled". Voice is off unless both the provider
# is selected and the key is present.
STT_PROVIDER=disabled
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
MAX_AUDIO_MB=100
# Ceiling on a single live dictation socket, so an abandoned connection cannot
# hold a provider stream open indefinitely.
VOICE_STREAM_MAX_SECONDS=300

# --- Analysis sandbox -------------------------------------------------------
# SANDBOX_BACKEND: "docker" | "http" | "disabled"
#   docker — the API shells out to a local daemon. Development only: it needs
#            the Docker socket, which is root on the host.
#   http   — delegates to the sandbox runner service. Required outside
#            development; the API refuses to start on "docker" there.
SANDBOX_BACKEND=http
SANDBOX_URL=http://sandbox:8080
# Shared secret between the API and the runner. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_AUTH_TOKEN=CHANGE_ME
SANDBOX_IMAGE=avocado-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_MAX_OUTPUT_BYTES=1048576

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=25

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional public demo login bypass -------------------------------------
# Enables POST /auth/demo-session and the "Try demo instantly" button on the
# sign-in page. Keep this off unless you are intentionally running a public demo.
PUBLIC_DEMO_ENABLED=false
# Recommended for staging/production: use a restricted demo account.
PUBLIC_DEMO_EMAIL=
PUBLIC_DEMO_PASSWORD=
# Development fallback only: if credentials are empty and PUBLIC_DEMO_ENABLED=true,
# the API can read owner credentials from this manifest path.
PUBLIC_DEMO_MANIFEST_PATH=./.demo-data/latest/manifest.json

# --- Optional deployment bootstrap -----------------------------------------
# AUTO_SEED_DEMO=true seeds Northwind demo data once the API is live.
# Idempotent guard: if workspaces already exist, seeding exits immediately.
AUTO_SEED_DEMO=false
DEMO_SEED_BASE_URL=http://127.0.0.1:8000
DEMO_SEED_WAIT_SECONDS=180
DEMO_SEED_POLL_SECONDS=1.5
DEMO_SEED_ROWS_PER_CSV=800
# DEMO_SEED_OUTPUT_DIR=/app/.demo-data/latest

# --- Tracing ---------------------------------------------------------------
# Off by default. When on, "console" prints spans to stdout (useful for
# verifying tracing works with no collector to stand up); "otlp" ships them to
# OTEL_ENDPOINT.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=avocado-api
OTEL_EXPORTER=console
OTEL_ENDPOINT=http://localhost:4318/v1/traces

# --- Tools / MCP ------------------------------------------------------------
# Every integration beyond the built-ins is a row here rather than a code
# change. One JSON array; each entry is one MCP server:
#
#   slug     what the tool is called. Lowercase letters, digits and dashes.
#            Matching a placeholder in the catalogue (wiki, calendar,
#            issue-tracker, ...) upgrades that card instead of adding a new one.
#   name     what a user sees.
#   url      the server's endpoint. Must be https outside development: these
#            requests carry a bearer token.
#   auth_ref the NAME of the environment variable holding the credential —
#            never the credential itself. Unset at boot is a startup error.
#   category analytics | engineering | knowledge | admin | data
#
# MCP_SERVERS=[{"slug":"wiki","name":"Confluence","url":"https://mcp.example.com/wiki","auth_ref":"WIKI_MCP_TOKEN","category":"knowledge"}]
# WIKI_MCP_TOKEN=CHANGE_ME
MCP_SERVERS=[]
MCP_TIMEOUT_SECONDS=30
